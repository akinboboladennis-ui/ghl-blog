---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const contactAction = `https://formsubmit.co/ajax/${site.contactEmail}`;
---

<Base
  title="Hire Dennis — GoHighLevel CRM Builds & AI Agents"
  description="Hire Dennis Akinbobola, GoHighLevel Solutions Architect: CRM builds, automations, AI agents, migrations, and integrations."
>
  <p class="pt-8 text-sm"><a class="underline" href="/">← Home</a></p>
  <h1 class="py-4 text-3xl font-bold">Hire Dennis to build your GHL system</h1>
  <p>
    I'm <strong>Dennis Akinbobola</strong>, a GoHighLevel Solutions Architect and HighLevel
    Certified Admin (Top Rated Plus on Upwork, 60+ jobs). I build the whole system: pipelines and
    automations, integrations between your tools, migrations from the platform you've outgrown, and
    AI agents that reply to leads before they go cold.
  </p>

  <h2 class="mt-6 text-xl font-bold">Services</h2>
  <ul class="mt-2 list-disc pl-6">
    <li>CRM setup or rebuild (GoHighLevel, HubSpot, Salesforce, Monday.com)</li>
    <li>Workflow automation: speed-to-lead, nurture, reminders, no-show recovery, reviews</li>
    <li>AI receptionist / voice AI (Vapi, Retell, GHL Voice AI) + chat/DM agents</li>
    <li>Integrations: Stripe, Twilio, Meta Lead Ads, Zapier, Make, n8n, webhooks &amp; APIs</li>
    <li>Migrations to GoHighLevel (Salesforce, Pipedrive, Systeme.io, ClickFunnels)</li>
    <li>Funnels, websites, member areas &amp; white-label agency dashboards</li>
  </ul>

  <h2 class="mt-6 text-xl font-bold">Who I build for</h2>
  <p class="mt-2">
    Appointment-based service businesses (med spas, chiropractors, clinics), coaches and course
    creators, and agencies needing white-label GHL builds. Based in Lagos, Nigeria — serving the
    US, Europe &amp; Australia, calls booked in your time zone.
  </p>

  <h2 class="mt-6 text-xl font-bold">Get a fixed-price quote</h2>
  <p class="mt-2">
    Tell me your CRM + goal below — I reply within 24 hours. Prefer chat?{' '}
    <a class="underline" href={site.whatsapp}>WhatsApp me →</a>
  </p>
  <div class="mt-4 rounded-lg border p-4" data-contact-box>
    <form class="space-y-2" action={contactAction} method="post">
      <input type="hidden" name="_subject" value="New hire-me inquiry from the blog" />
      <input
        type="hidden"
        name="_autoresponse"
        value="Thanks for reaching out! I got your project details and will reply within 24 hours with next steps. — Dennis"
      />
      <input
        class="w-full rounded border px-3 py-2"
        type="text"
        name="name"
        placeholder="Your name"
        required
      />
      <input
        class="w-full rounded border px-3 py-2"
        type="email"
        name="email"
        placeholder="Email"
        required
      />
      <input
        class="w-full rounded border px-3 py-2"
        type="text"
        name="crm"
        placeholder="What CRM do you use today? (e.g. GoHighLevel, none yet)"
      />
      <textarea
        class="w-full rounded border px-3 py-2"
        name="message"
        rows="4"
        placeholder="What do you want built?"
        required
      ></textarea>
      <button
        class="rounded bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700"
        type="submit"
      >
        Request quote →
      </button>
    </form>
    <p class="contact-note mt-2 hidden text-sm"></p>
  </div>
  <p class="mt-4 text-sm text-slate-500">
    Budgets typically under $1,000 to $10,000+ depending on scope. Also on{' '}
    <a class="underline" href="https://www.upwork.com/">Upwork</a> and{' '}
    <a class="underline" href={site.officialSite}>dennisakinbobola.com</a>.
  </p>
</Base>

<script>
  const box = document.querySelector('[data-contact-box] form');
  if (box) {
    const f = box as HTMLFormElement;
    const note = f.parentElement?.querySelector('.contact-note');
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = f.querySelector('button');
      if (btn) btn.textContent = 'Sending…';
      try {
        const data = Object.fromEntries(new FormData(f).entries());
        const res = await fetch(f.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error();
        if (note) {
          note.textContent = 'Sent! I reply within 24 hours — check your inbox.';
          note.classList.remove('hidden');
        }
        f.reset();
      } catch {
        if (note) {
          note.textContent = 'Something went wrong — please WhatsApp me instead.';
          note.classList.remove('hidden');
        }
      }
      if (btn) btn.textContent = 'Request quote →';
    });
  }
</script>
