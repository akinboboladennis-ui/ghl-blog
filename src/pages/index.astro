---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getCollection } from 'astro:content';
import { site } from '../site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a,b)=> b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 9);
const featured = posts[0];
const rest = posts.slice(1);
---

<Base title="I turn messy CRMs into systems that sell." description="Practical GoHighLevel tutorials, comparisons, and agency architecture guides from Dennis Akinbobola, HighLevel Certified Admin.">

<!-- HERO -->
<section class="relative overflow-hidden rounded-b-[2rem] bg-gradient-to-br from-[#0A2540] via-[#0A2540] to-[#0F3A5C] text-white -mx-5 px-5 pb-16 pt-14 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
  <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
  <div class="absolute -left-24 top-24 h-72 w-72 rounded-full bg-sky-500/20 blur-3xl"></div>
  <div class="relative">
    <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold tracking-widest uppercase">
      <span class="h-2 w-2 rounded-full bg-emerald-400"></span> HighLevel Certified Admin · 60+ Upwork jobs
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl sm:text-5xl font-extrabold leading-tight">
      I turn messy CRMs into <span class="text-emerald-400">systems that sell.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">
      GoHighLevel builds, automations, AI receptionists, and integrations for clinics, coaches, and agencies.
      Practical tutorials — no fluff, no theory.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/hire-me" class="rounded-full bg-emerald-500 px-6 py-3 font-bold text-white hover:bg-emerald-400">Get a free CRM audit →</a>
      <a href="/products/" class="rounded-full border border-white/30 px-6 py-3 font-semibold hover:bg-white/10">Grab a $99 Snapshot</a>
      <a href={site.ghlAffiliate} target="_blank" rel="sponsored sponsored nofollow" class="rounded-full bg-white px-6 py-3 font-bold text-[#0A2540] hover:bg-slate-100">Try GoHighLevel free ↗</a>
    </div>
    <p class="mt-3 text-xs text-slate-400">Affiliate link — I may earn a commission at no cost to you. <a href="/disclosure" class="underline">Disclosure</a></p>
  </div>
</section>

<!-- SOCIAL PROOF -->
<section class="mt-10">
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-2xl border p-5 dark:border-slate-800"><p class="text-3xl font-black text-emerald-600">60+</p><p class="text-sm text-slate-500">Upwork jobs · Top Rated Plus</p></div>
    <div class="rounded-2xl border p-5 dark:border-slate-800"><p class="text-3xl font-black text-emerald-600">10% → 40%</p><p class="text-sm text-slate-500">Med-spa booking lift</p></div>
    <div class="rounded-2xl border p-5 dark:border-slate-800"><p class="text-3xl font-black text-emerald-600">3</p><p class="text-sm text-slate-500">Continents served (US/EU/AU)</p></div>
    <div class="rounded-2xl border p-5 dark:border-slate-800"><p class="text-3xl font-black text-emerald-600">40%</p><p class="text-sm text-slate-500">GHL affiliate — on every trial</p></div>
  </div>
  <div class="mt-6 overflow-hidden rounded-2xl bg-emerald-50 py-3 dark:bg-emerald-950">
    <div class="marquee flex gap-8 whitespace-nowrap text-sm font-medium text-emerald-800 dark:text-emerald-200">
      <span>✓ Med-spa follow-up system · 10% → 40%</span><span>✓ AI receptionist for US home organizer</span><span>✓ CloseBot AI for orthodontic clinics</span><span>✓ GHL chatbot for law firm</span><span>✓ Funnel + automation for The Short Diet (NZ)</span>
      <span>✓ Med-spa follow-up system · 10% → 40%</span><span>✓ AI receptionist for US home organizer</span><span>✓ CloseBot AI for orthodontic clinics</span><span>✓ GHL chatbot for law firm</span><span>✓ Funnel + automation for The Short Diet (NZ)</span>
    </div>
  </div>
</section>

<!-- ROICalc -->
<section class="mt-10">
  <div class="rounded-3xl border dark:border-slate-800 p-6 sm:p-8" id="roi">
    <h2 class="text-2xl font-extrabold">What's a missed pipeline costing you?</h2>
    <p class="mt-1 text-slate-500">Drag the sliders. Most clinics lose $2k–$8k/month to no-show + slow follow-up.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <label class="text-sm">Leads / month <span id="leadsVal" class="font-bold text-emerald-600">80</span>
        <input id="leads" type="range" min="20" max="500" value="80" class="w-full accent-emerald-600" />
      </label>
      <label class="text-sm">Show rate today <span id="showVal" class="font-bold text-emerald-600">50%</span>
        <input id="show" type="range" min="10" max="90" value="50" class="w-full accent-emerald-600" />
      </label>
    </div>
    <div class="mt-6 flex flex-wrap items-end gap-6">
      <p><span class="text-sm text-slate-500">Lost bookings / mo</span><br/><span id="lost" class="text-3xl font-black">40</span></p>
      <p><span class="text-sm text-slate-500">Est. revenue lost @ $150 avg</span><br/><span id="rev" class="text-3xl font-black text-red-500">$6,000</span></p>
      <a href="/hire-me" class="ml-auto rounded-full bg-emerald-600 px-5 py-2.5 font-bold text-white">Fix this →</a>
    </div>
    <script>
      const leads=document.getElementById('leads'), show=document.getElementById('show');
      const up=()=>{const l=+leads.value,s=+show.value;
        document.getElementById('leadsVal').textContent=l;
        document.getElementById('showVal').textContent=s+'%';
        const lost=Math.round(l*(1-s/100));
        document.getElementById('lost').textContent=lost;
        document.getElementById('rev').textContent='$'+(lost*150).toLocaleString();};
      leads.oninput=show.oninput=up;up();
    </script>
  </div>
</section>

<!-- FEATURED + grid -->
<section id="posts" class="mt-12">
  <h2 class="text-2xl font-extrabold">Latest posts</h2>
  {featured && (
    <a href={`/blog/${featured.id.replace(/\.mdx$/,'')}/`} class="mt-6 block rounded-3xl bg-gradient-to-br from-[#0A2540] to-[#123E66] p-8 text-white hover:opacity-95">
      <p class="text-xs font-bold tracking-widest uppercase text-emerald-400">Featured</p>
      <h3 class="mt-2 text-2xl font-extrabold">{featured.data.title}</h3>
      <p class="mt-2 text-slate-300">{featured.data.description}</p>
      <p class="mt-4 text-sm font-semibold">Read the guide →</p>
    </a>
  )}
  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {rest.map(post=>(
      <a href={`/blog/${post.id.replace(/\.mdx$/,'')}/`} class="rounded-2xl border p-5 hover:border-emerald-400 hover:shadow-lg transition dark:border-slate-800">
        <h3 class="font-bold leading-snug hover:text-emerald-600">{post.data.title}</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{post.data.description}</p>
        <p class="mt-3 text-xs text-slate-500">{post.data.pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</p>
      </a>
    ))}
  </div>
</section>

<!-- Monetization block -->
<section class="mt-12">
  <h2 class="text-2xl font-extrabold">Start free, upgrade when it works</h2>
  <div class="mt-5 grid gap-5 sm:grid-cols-3">
    <a href="/products/" class="rounded-2xl border-2 border-emerald-500 p-6 hover:shadow-xl transition">
      <p class="text-xs font-bold tracking-widest uppercase text-emerald-600">Digital product</p>
      <h3 class="mt-1 text-xl font-extrabold">Dentist Snapshot — $99</h3>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">One-click install: funnel, pipeline, automations, calendar. Ship your clinic in an afternoon.</p>
      <p class="mt-3 font-bold">Get the snapshot →</p>
    </a>
    <a href={site.ghlAffiliate} target="_blank" rel="sponsored nofollow" class="rounded-2xl border p-6 hover:shadow-xl transition dark:border-slate-800">
      <p class="text-xs font-bold tracking-widest uppercase text-emerald-600">Affiliate</p>
      <h3 class="mt-1 text-xl font-extrabold">GoHighLevel free trial</h3>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Build on the platform I use daily. I earn 40% recurring if you subscribe — no cost to you.</p>
      <p class="mt-3 font-bold">Start free trial ↗</p>
    </a>
    <a href="/hire-me" class="rounded-2xl bg-[#0A2540] p-6 text-white hover:shadow-xl transition">
      <p class="text-xs font-bold tracking-widest uppercase text-emerald-400">Done-for-you</p>
      <h3 class="mt-1 text-xl font-extrabold">Hire Dennis</h3>
      <p class="mt-2 text-sm text-slate-300">CRM build, migrations, AI agents, integrations. Fixed price, 24h reply.</p>
      <p class="mt-3 font-bold">Get a quote →</p>
    </a>
  </div>
</section>

<!-- Newsletter -->
<section class="mt-12 rounded-3xl bg-gradient-to-r from-emerald-600 to-emerald-500 p-8 text-white">
  <h2 class="text-2xl font-extrabold">One GHL tactic every Tuesday. No spam.</h2>
  <p class="mt-2 text-emerald-50">Join 1,000+ agency owners getting the exact workflows I deploy for clients.</p>
  <div class="mt-5"><NewsletterForm /></div>
</section>

</Base>
